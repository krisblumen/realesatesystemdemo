# =============================================================================
# NEW HAUZ — Variables de entorno
# Copia este archivo como .env y ajusta los valores para tu ambiente.
#
# Ambientes disponibles:
#   local      → Desarrollo individual (este archivo)
#   dev        → Integración técnica del equipo
#   staging    → Validación QA/UAT antes de producción
#   production → Sitio público
# =============================================================================

APP_NAME="Real Estate System Demo"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Base de datos — PostgreSQL + PostGIS
# Local sin Docker: DB_HOST=127.0.0.1
# Con Docker (RFC-010): DB_HOST=postgres
# -----------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=demo_db
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Correo — Mailpit para desarrollo local (UI web en puerto 8025)
# -----------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@newhauz.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_QUEUE_CONNECTION=database

# -----------------------------------------------------------------------------
# Google Maps API (RFC-043)
# -----------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=

# -----------------------------------------------------------------------------
# Storage S3/R2 — solo para staging y production
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_GOOGLE_MAPS_API_KEY="${GOOGLE_MAPS_API_KEY}"

LEADS_AUTO_ASSIGNMENT_ENABLED=true
LEADS_ASSIGNMENT_STRATEGY=priority_round_robin
LEADS_ASSIGNMENT_RECENT_DAYS=30

# -----------------------------------------------------------------------------
# Demo multi-inquilino (EPICA-DEMO, RFC-01 a RFC-14)
#
# Los valores comentados son el default del código: descomentar sólo para
# cambiarlos. Las que están sin comentar hay que definirlas.
# -----------------------------------------------------------------------------

# Cada inquilino vive en {slug}.{dominio_base}.
#TENANCY_DOMINIO_BASE=demo.localhost

# A dónde mandar a quien llega al dominio base sin subdominio.
# Vacío: el host central sirve su propia página mínima.
TENANCY_SITIO_PROMOCIONAL=

# Nombres de base. El prefijo se interpola en CREATE DATABASE y es parte de
# la defensa (RFC-05): no es cosmética.
#TENANCY_PREFIJO_INQUILINO=demo_t_
#TENANCY_PREFIJO_PLANTILLA=demo_template
#TENANCY_PREFIJO_PRUEBAS=demo_probe_t_
#TENANCY_PLANTILLA=demo_template

# Centinela de conexión sin resolver. NUNCA vacío: Postgres con nombre de base
# vacío conecta a la base del usuario y una consulta prematura escribiría en
# otro lado, en silencio.
#TENANCY_CENTINELA=demo_sin_resolver

# Ciclo de vida, en días.
#TENANCY_DIAS_DE_VIDA=30
#TENANCY_DIAS_SIN_USO=5
#TENANCY_DIAS_DE_ENLACE=7

# OBLIGATORIA. Sal del hash de origen. Sin ella el sistema se NIEGA a hashear
# en vez de usar cadena vacía: un límite que parece funcionar y no protege es
# peor que ninguno. Fija y con dueño — si rota, los límites se pierden sin que
# nadie se entere.
TENANCY_SAL_DE_ORIGEN=

# Topes de alta (RFC-10). El tope duro protege las conexiones de Postgres, que
# se comparten con la producción vecina; el de origen sólo evita que un actor
# se lleve todos los lugares de una sentada.
#TENANCY_TOPE_OCUPADOS=20
#TENANCY_ALTAS_POR_ORIGEN=3
#TENANCY_VENTANA_HORAS=24

# Secreto compartido del alta por API (RFC-078). VACÍO APAGA EL ENDPOINT: la
# ruta responde 404 y el sistema se comporta como si RFC-078 no existiera. Es
# deliberado — un despliegue que olvide configurarlo deja la puerta cerrada.
# Generar con: php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'
TENANCY_SECRETO_DE_ALTAS=

# A quién avisar de cada alta. Vacío desactiva el aviso sin romper nada.
TENANCY_AVISO_DE_ALTAS=

# Cerrojo de aprovisionamiento (pg_advisory_lock sobre la plantilla).
#TENANCY_CERROJO_CLAVE=728401
#TENANCY_CERROJO_INTENTOS=10
#TENANCY_CERROJO_ESPERA_MS=300

# Rol con el que corre la aplicación, para las concesiones sobre cada base nueva.
TENANCY_ROL_APLICACION=

# Lo pone demo:plantilla:construir en su proceso hijo. Vacío en cualquier otro
# contexto: si no, los medios de la plantilla se pisan con los de otra base.
TENANCY_MEDIOS_DE_PLANTILLA=
